{
  "name": "cv-portfolios",
  "version": "2.0.0",
  "description": "Data-driven CV portfolio generator — monorepo",
  "scripts": {
    "generate": "node scripts/generate-portfolio.js",
    "generate:mireia": "node scripts/generate-portfolio.js mireia",
    "generate:***REMOVED***": "node scripts/generate-portfolio.js ***REMOVED***",
    "generate:all": "node scripts/generate-portfolio.js mireia && node scripts/generate-portfolio.js ***REMOVED***",
    "serve:mireia": "npx serve portfolios/mireia/dist -p 3000",
    "serve:***REMOVED***": "npx serve portfolios/***REMOVED***/dist -p 3001",
    "new-portfolio": "node scripts/new-portfolio.js",
    "parse-pdf": "node scripts/parse-pdf.js",
    "pdf": "node scripts/generate-pdf.js",
    "pdf:mireia": "node scripts/generate-pdf.js mireia",
    "pdf:***REMOVED***": "node scripts/generate-pdf.js ***REMOVED***"
  },
  "keywords": ["cv", "portfolio", "generator"],
  "author": "Aitor",
  "license": "MIT",
  "devDependencies": {}
}
